<Window x:Class="HabitTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker - Вход" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Habit Tracker" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Margin="0,5" Text="{Binding Username}" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Margin="0,5"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Вход" Width="100" Margin="5" Click="Login_Click"/>
            <Button Content="Регистрация" Width="100" Margin="5" Click="Register_Click"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="4" Foreground="Red" HorizontalAlignment="Center"/>
    </Grid>
</Window>