<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker" Height="600" Width="900"
        WindowState="Maximized" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="UserGreeting" Text="Пользователь" Foreground="White" VerticalAlignment="Center" Margin="10"/>
                <Button x:Name="ExitButton" Content="Выход" Width="80" Margin="5" Click="ExitButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Основной TabControl -->
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Привычки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddHabitButton" Content="+ Добавить привычку" Width="150" Margin="0,0,10,0" Click="AddHabitButton_Click"/>
                        <Button x:Name="DeleteHabitButton" Content="Удалить выбранную" Width="150" Click="DeleteHabitButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="HabitsList" Grid.Row="1" DisplayMemberPath="Name" SelectionMode="Single"/>
                </Grid>
            </TabItem>
            <TabItem Header="Категории">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="NewCategoryBox" Width="150" Margin="0,0,10,0"/>
                        <Button x:Name="AddCategoryButton" Content="Добавить категорию" Width="150" Margin="0,0,10,0" Click="AddCategoryButton_Click"/>
                        <Button x:Name="DeleteCategoryButton" Content="Удалить категорию" Width="150" Click="DeleteCategoryButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="CategoriesList" Grid.Row="1" DisplayMemberPath="Name"/>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика">
                <Grid Margin="10">
                    <TextBlock Text="Здесь будут графики и проценты" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="Настройки">
                <StackPanel Margin="10">
                    <Button x:Name="ExportButton" Content="Экспорт отчёта (CSV)" Width="200" Margin="5" Click="ExportButton_Click"/>
                    <Button x:Name="DeleteAccountButton" Content="Удалить аккаунт" Width="200" Margin="5" Background="Red" Foreground="White" Click="DeleteAccountButton_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>